{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "喵剧AI",
  "mainBinaryName": "miaoju",
  "version": "../package.json",
  "identifier": "com.miaoju.desktop",
  "build": {
    "frontendDist": "../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @miaoju/web dev",
    "beforeBuildCommand": "pnpm --filter @miaoju/web build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "喵剧AI", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 680, "dragDropEnabled": false }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: http://127.0.0.1:*; media-src 'self' blob: https: http://127.0.0.1:*; connect-src 'self' blob: ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; worker-src 'self' blob:; base-uri 'self'; form-action 'none'; object-src 'none'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "externalBin": ["binaries/sidecar", "binaries/miaoju-cli"],
    "resources": { "resources/python/": "python/", "resources/cli-skill/": "cli-skill/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "14.0", "signingIdentity": "-" }
  }
}
